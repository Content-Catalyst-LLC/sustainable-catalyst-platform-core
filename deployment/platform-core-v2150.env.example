SC_CORE_SCALE_PARTITION_LEASE_SECONDS=120
SC_CORE_SCALE_INLINE_RESULT_MAX_BYTES=262144
SC_CORE_SCALE_QUEUE_BACKPRESSURE_THRESHOLD=1000
