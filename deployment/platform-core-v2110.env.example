# Sustainable Catalyst Platform Core v2.11.0
SC_CORE_ENVIRONMENT=production
SC_CORE_PUBLIC_READS=true
SC_CORE_HUMANITARIAN_FABRIC_ENABLED=true
SC_CORE_HUMANITARIAN_AUTO_MATERIALIZE=true
# HDX HAPI is free/public and uses an identifying application string.
SC_CORE_HDX_HAPI_APP_IDENTIFIER=sustainable-catalyst-platform-core
# ReliefWeb requires an appname. Report metadata remains contextual unless a structured extraction exists.
SC_CORE_RELIEFWEB_APPNAME=
# External provider health is observable but does not block Core release readiness.
