# Platform Core v2.24.0 — Capacity Forecasting & Resource Governance
# Capacity forecasts and soft limits are advisory. Core does not auto-scale, buy infrastructure, mutate deployments, or enforce hard admission control.

SC_CORE_CAPACITY_RESOURCE_GOVERNANCE_ENABLED=true
SC_CORE_CAPACITY_PUBLIC_STATUS_ENABLED=true
SC_CORE_CAPACITY_DEFAULT_WARNING_UTILIZATION_PERCENT=80
SC_CORE_CAPACITY_DEFAULT_CRITICAL_UTILIZATION_PERCENT=95
SC_CORE_CAPACITY_DEFAULT_FORECAST_HORIZON_HOURS=24
SC_CORE_CAPACITY_FORECAST_WINDOW_HOURS=168
SC_CORE_CAPACITY_MIN_FORECAST_POINTS=3
SC_CORE_CAPACITY_OBSERVATION_RETENTION_HOURS=2160
SC_CORE_CERTIFICATION_REQUIRE_CAPACITY_READY=false

# Existing v2.23.x federation controls remain inherited.
SC_CORE_FEDERATION_TRUSTED_NODE_EXCHANGE_ENABLED=true
SC_CORE_FEDERATION_PUBLIC_STATUS_ENABLED=true
SC_CORE_FEDERATION_LOCAL_NODE_ID=core-primary
SC_CORE_FEDERATION_MANIFEST_SIGNATURE_REQUIRED=true
SC_CORE_FEDERATION_MAX_MANIFEST_ITEMS=500
SC_CORE_CERTIFICATION_REQUIRE_FEDERATION_READY=false

# Pairwise federation secrets remain runtime-only. Never commit live values.
# SC_CORE_FEDERATION_TRUST_SECRETS_JSON={"remote-node-id":"replace-with-long-random-secret"}
