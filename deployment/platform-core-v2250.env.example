# Platform Core v2.25.0 — Identity, Credential & Cryptographic Key Lifecycle
# Core stores credential lifecycle metadata and secret locators only. Never place live secret values in this file.

SC_CORE_CREDENTIAL_KEY_LIFECYCLE_ENABLED=true
SC_CORE_CREDENTIAL_PUBLIC_STATUS_ENABLED=true
SC_CORE_CREDENTIAL_DEFAULT_ROTATION_DAYS=90
SC_CORE_CREDENTIAL_DEFAULT_OVERLAP_MINUTES=60
SC_CORE_CREDENTIAL_EXPIRY_WARNING_DAYS=14
SC_CORE_CREDENTIAL_USE_EVENT_RETENTION_HOURS=2160
SC_CORE_CERTIFICATION_REQUIRE_CREDENTIAL_LIFECYCLE_READY=false

# Existing runtime secret bindings remain environment-managed and are referenced by metadata only.
# SC_CORE_WRITE_API_KEY=<set in secret manager/runtime environment>
# SC_CORE_WEBHOOK_SIGNING_SECRET=<set in secret manager/runtime environment>
# SC_CORE_DOSSIER_SIGNING_SECRET=<set in secret manager/runtime environment>
# SC_CORE_FEDERATION_TRUST_SECRETS_JSON={"remote-node-id":"replace-with-long-random-secret"}
