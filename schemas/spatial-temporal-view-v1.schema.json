  "type": "object",
  "title": "Spatial Temporal View",
  "required": [
    "view_key",
    "name"
  ],
  "properties": {
    "view_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "view_kind": {
      "type": "string"
    },
    "spatial_window": {
      "type": "object"
    },
    "layers": {
      "type": "array"
    }
  }
}
