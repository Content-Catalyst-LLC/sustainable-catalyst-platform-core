{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/humanitarian-condition-v1.schema.json",
  "title": "Humanitarian Condition",
  "type": "object",
  "required": ["country_code", "service_domain", "condition_kind", "semantic_role", "observed_at", "publisher"],
  "properties": {
    "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "service_domain": {"type": "string"},
    "condition_kind": {"type": "string"},
    "semantic_role": {"enum": ["operational-condition", "humanitarian-indicator", "structural-baseline", "classification", "contextual-report", "other"]},
    "status_value": {"type": ["string", "null"]},
    "value_number": {"type": ["number", "null"]},
    "value_text": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "publisher": {"type": "string"},
    "facility_id": {"type": ["string", "null"]},
    "evidence_class": {"type": "string"},
    "dimensions": {"type": "object"},
    "details": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "anyOf": [
    {"required": ["status_value"]},
    {"required": ["value_number"]},
    {"required": ["value_text"]}
  ]
}
