          "type": "boolean"
        },
        "interpretation_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Interpretation Refs",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
