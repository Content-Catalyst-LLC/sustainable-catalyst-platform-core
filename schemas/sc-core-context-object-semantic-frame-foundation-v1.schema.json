{
  "$defs": {
    "ContextObject": {
      "properties": {
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "context_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Context Id",
          "type": "string"
        },
        "context_is_interpretive_container_not_evidence": {
          "const": true,
          "default": true,
          "title": "Context Is Interpretive Container Not Evidence",
          "type": "boolean"
        },
        "following_context_refs": {
          "items": {
            "type": "string"
          },
          "title": "Following Context Refs",
          "type": "array"
        },
        "language_ref": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Language Ref",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_context_ref": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Context Ref"
        },
        "preceding_context_refs": {
          "items": {
            "type": "string"
          },
          "title": "Preceding Context Refs",
          "type": "array"
        },
        "provenance_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Provenance Ref",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/ContextScopeKind"
        },
        "source_authority_unchanged_by_context_selection": {
          "const": true,
          "default": true,
          "title": "Source Authority Unchanged By Context Selection",
          "type": "boolean"
        },
        "source_binding_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Source Binding Ref",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "source_binding_ref",
        "scope_kind",
        "char_start",
        "char_end",
        "content",
        "content_sha256",
        "language_ref",
        "provenance_ref"
      ],
      "title": "ContextObject",
      "type": "object"
    },
    "ContextScopeKind": {
      "enum": [
        "sentence",
        "paragraph",
        "section",
        "document",
        "conversation",
        "research-session",
        "cross-document"
      ],
      "title": "ContextScopeKind",
      "type": "string"
    },
    "ContextSemanticPolicy": {
      "properties": {
        "context_graph_mutation_authorized": {
          "const": false,
          "default": false,
          "title": "Context Graph Mutation Authorized",
          "type": "boolean"
        },
        "context_is_explicit_and_persistent": {
          "const": true,
          "default": true,
          "title": "Context Is Explicit And Persistent",
          "type": "boolean"
        },
        "context_selection_does_not_promote_source_authority": {
          "const": true,
          "default": true,
          "title": "Context Selection Does Not Promote Source Authority",
          "type": "boolean"
        },
        "evidence_graph_mutation_authorized": {
          "const": false,
          "default": false,
          "title": "Evidence Graph Mutation Authorized",
          "type": "boolean"
        },
        "identity_graph_mutation_authorized": {
          "const": false,
          "default": false,
          "title": "Identity Graph Mutation Authorized",
          "type": "boolean"
        },
        "interpretation_is_not_truth_verdict": {
          "const": true,
          "default": true,
          "title": "Interpretation Is Not Truth Verdict",
          "type": "boolean"
        },
        "machine_interpretation_is_advisory": {
          "const": true,
          "default": true,
          "title": "Machine Interpretation Is Advisory",
          "type": "boolean"
        },
        "multiple_interpretations_may_coexist": {
          "const": true,
          "default": true,
          "title": "Multiple Interpretations May Coexist",
          "type": "boolean"
        },
        "original_language_remains_primary": {
          "const": true,
          "default": true,
          "title": "Original Language Remains Primary",
          "type": "boolean"
        },
        "policy_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Policy Id",
          "type": "string"
        },
        "semantic_frame_is_not_evidence_fact": {
          "const": true,
          "default": true,
          "title": "Semantic Frame Is Not Evidence Fact",
          "type": "boolean"
        },
        "semantic_interpretation_preserves_provenance": {
          "const": true,
          "default": true,
          "title": "Semantic Interpretation Preserves Provenance",
          "type": "boolean"
        },
        "translations_remain_derived": {
          "const": true,
          "default": true,
          "title": "Translations Remain Derived",
          "type": "boolean"
        },
        "unresolved_reference_may_be_preserved": {
          "const": true,
          "default": true,
          "title": "Unresolved Reference May Be Preserved",
          "type": "boolean"
        }
      },
      "required": [
        "policy_id"
      ],
      "title": "ContextSemanticPolicy",
      "type": "object"
    },
    "ContextSemanticProvenanceRecord": {
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "machine_or_graph_output_is_advisory": {
          "const": true,
          "default": true,
          "title": "Machine Or Graph Output Is Advisory",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "$ref": "#/$defs/InterpretationMethod"
        },
        "model_ref": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "model_version": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "produced_by_ref": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Produced By Ref",
          "type": "string"
        },
        "provenance_does_not_establish_semantic_truth": {
          "const": true,
          "default": true,
          "title": "Provenance Does Not Establish Semantic Truth",
          "type": "boolean"
        },
        "provenance_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Provenance Id",
          "type": "string"
        },
        "review_note": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "reviewer_ref": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Ref"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "subject_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Refs",
          "type": "array"
        },
        "tool_ref": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Ref"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "provenance_id",
        "subject_refs",
        "method",
        "produced_by_ref",
        "source_refs"
      ],
      "title": "ContextSemanticProvenanceRecord",
      "type": "object"
    },
    "ContextSemanticSnapshot": {
      "properties": {
        "context_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Context Refs",
          "type": "array"
        },
        "deterministic_context_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deterministic Context Fingerprint Sha256",
          "type": "string"
        },
        "immutable": {
          "const": true,
          "default": true,
