{
  "$defs": {
    "EpistemicState": {
      "enum": [
        "governed-record",
        "source-asserted",
        "candidate",
        "hypothesis",
        "analytical",
        "qualified",
        "unresolved",
        "remote-reference",
        "runtime-metadata"
      ],
      "title": "EpistemicState",
      "type": "string"
    },
    "QueryExecutionDisposition": {
      "enum": [
        "complete-with-qualifications",
        "partial",
        "blocked"
      ],
      "title": "QueryExecutionDisposition",
      "type": "string"
    },
    "QueryMode": {
      "enum": [
        "exact",
        "exploratory",
        "provenance",
        "graph-context",
        "timeline",
        "federation-reference"
      ],
      "title": "QueryMode",
      "type": "string"
    },
    "QueryPlanStep": {
      "properties": {
        "allowed_epistemic_states": {
          "items": {
            "$ref": "#/$defs/EpistemicState"
          },
          "minItems": 1,
          "title": "Allowed Epistemic States",
          "type": "array"
        },
        "capability_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Capability Ref",
          "type": "string"
        },
        "dependency_step_refs": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Step Refs",
          "type": "array"
        },
        "may_mutate_governed_graphs": {
          "const": false,
          "default": false,
          "title": "May Mutate Governed Graphs",
          "type": "boolean"
        },
        "may_promote_epistemic_state": {
          "const": false,
          "default": false,
          "title": "May Promote Epistemic State",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "operation": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Operation",
          "type": "string"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "output_contract": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Output Contract",
          "type": "string"
        },
        "query_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Query Ref",
          "type": "string"
        },
        "step_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Step Id",
          "type": "string"
        },
        "target_kind": {
          "$ref": "#/$defs/QueryTargetKind"
        }
      },
      "required": [
        "step_id",
        "query_ref",
        "ordinal",
        "capability_ref",
        "target_kind",
        "operation",
        "output_contract",
        "allowed_epistemic_states"
      ],
      "title": "QueryPlanStep",
      "type": "object"
    },
    "QueryProvenanceReference": {
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provenance_is_not_truth_certification": {
          "const": true,
          "default": true,
          "title": "Provenance Is Not Truth Certification",
          "type": "boolean"
        },
        "provenance_ref_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Provenance Ref Id",
          "type": "string"
        },
        "source_contract": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Source Contract",
          "type": "string"
        },
        "source_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint Sha256",
          "type": "string"
        },
        "source_kind": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Source Kind",
          "type": "string"
        },
        "source_object_ref": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Source Object Ref",
          "type": "string"
        }
      },
      "required": [
        "provenance_ref_id",
        "source_contract",
        "source_object_ref",
        "source_fingerprint_sha256",
        "source_kind"
      ],
      "title": "QueryProvenanceReference",
      "type": "object"
    },
    "QueryTargetKind": {
      "enum": [
        "entity",
        "temporal-identity",
        "record-linkage",
        "source-reconciliation",
        "documentary-source",
        "relationship",
        "network-structure",
        "connection-path",
        "evidence-chain",
        "multi-hop-reasoning",
        "contradiction",
        "timeline",
        "investigation-package",
        "federation-reference",
        "runtime-metadata"
      ],
      "title": "QueryTargetKind",
      "type": "string"
    },
    "ResultValidationState": {
      "enum": [
        "governed-reference",
        "review-required",
        "local-validation-required",
        "analytical-only",
        "unresolved",
        "metadata-only"
      ],
      "title": "ResultValidationState",
      "type": "string"
    },
    "UnifiedEntityEvidenceQuery": {
      "properties": {
        "consumer_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Consumer Ref",
          "type": "string"
        },
        "include_epistemic_state": {
          "const": true,
          "default": true,
          "title": "Include Epistemic State",
          "type": "boolean"
        },
        "include_provenance": {
          "const": true,
          "default": true,
          "title": "Include Provenance",
          "type": "boolean"
        },
        "include_source_contract": {
          "const": true,
          "default": true,
          "title": "Include Source Contract",
          "type": "boolean"
        },
        "include_validation_state": {
          "const": true,
          "default": true,
          "title": "Include Validation State",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/QueryMode"
        },
        "policy_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Policy Ref",
          "type": "string"
        },
        "query_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Query Id",
          "type": "string"
        },
        "query_is_not_truth_instruction": {
          "const": true,
          "default": true,
          "title": "Query Is Not Truth Instruction",
          "type": "boolean"
        },
        "query_text": {
          "maxLength": 8000,
          "minLength": 3,
          "title": "Query Text",
          "type": "string"
        },
        "requested_at": {
          "maxLength": 80,
          "minLength": 10,
          "title": "Requested At",
          "type": "string"
        },
        "requested_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Fields",
          "type": "array"
        },
        "scope_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Scope Ref",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "policy_ref",
        "scope_ref",
        "consumer_ref",
        "query_text",
        "mode",
        "requested_fields",
        "requested_at"
      ],
      "title": "UnifiedEntityEvidenceQuery",
      "type": "object"
    },
    "UnifiedQueryExecutionTrace": {
      "properties": {
