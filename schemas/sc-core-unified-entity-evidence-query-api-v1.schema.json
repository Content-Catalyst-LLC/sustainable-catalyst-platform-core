          "title": "Step Refs",
          "type": "array"
        },
        "trace_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Trace Id",
          "type": "string"
        },
        "trace_is_not_truth_assessment": {
          "const": true,
