{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Visual Reasoning Snapshot v1",
  "required": [
    "id",
    "visual_entity_id",
    "snapshot_key",
    "state_hash",
    "semantic_state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "visual_entity_id": {
      "type": "string"
    },
    "snapshot_key": {
      "type": "string"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_state": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "created_by": {
      "type": "string"
    }
  }
}
