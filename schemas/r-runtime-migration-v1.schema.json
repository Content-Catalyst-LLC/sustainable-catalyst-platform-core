{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/r-runtime-migration-v1.schema.json",
  "title": "Sustainable Catalyst Analytics R Migration / R Runtime 1.0",
  "type": "object",
  "required": [
    "migration_plan",
    "runtime_registration",
    "source_ai_research_contract",
    "core_release"
