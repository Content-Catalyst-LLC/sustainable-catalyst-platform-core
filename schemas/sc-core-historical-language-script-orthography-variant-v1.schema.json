          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "orthography_profile_id",
        "language_stage_ref",
        "script_variant_ref",
        "canonical_label"
      ],
      "title": "OrthographyProfile",
