{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Sensitivity Result",
  "required": [
    "factor_id",
    "metric_kind",
    "output_key",
    "value"
  ],
  "properties": {
    "factor_id": {
      "type": "string"
    },
    "metric_kind": {
      "enum": [
        "effect",
        "elasticity",
        "correlation",
        "sobol-first",
        "sobol-total",
        "morris-mu-star",
        "rank",
        "custom"
      ]
    },
    "output_key": {
      "type": "string"
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "lower_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "upper_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "rank_position": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_execution": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
