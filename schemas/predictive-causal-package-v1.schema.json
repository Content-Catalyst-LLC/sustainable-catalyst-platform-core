  "title": "Sustainable Catalyst Predictive Causal Package v1",
  "type": "object",
  "required": ["contract", "study", "variable_bindings", "intervention_scenarios", "counterfactual_forecasts", "causal_effect_evidence", "evaluations", "handoffs"],
