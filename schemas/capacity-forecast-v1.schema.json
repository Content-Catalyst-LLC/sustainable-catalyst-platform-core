{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capacity Forecast v1",
  "type": "object",
  "required": ["profile_id", "method", "window_hours", "horizon_hours", "observed_points", "confidence", "state"],
  "properties": {
    "profile_id": {"type": "string"},
    "method": {"const": "bounded-linear"},
    "window_hours": {"type": "integer", "minimum": 1},
    "horizon_hours": {"type": "integer", "minimum": 1},
    "observed_points": {"type": "integer", "minimum": 0},
    "current_value": {"type": ["number", "null"]},
    "slope_per_hour": {"type": ["number", "null"]},
    "predicted_value": {"type": ["number", "null"]},
    "predicted_utilization": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "state": {"enum": ["insufficient-data", "stable", "warning", "critical"]},
    "hours_to_capacity": {"type": ["number", "null"]},
    "evidence": {"type": "object"}
  }
}
