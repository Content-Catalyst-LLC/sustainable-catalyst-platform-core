{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/credential-key-version-v1.schema.json",
  "title": "Credential Key Version Metadata",
  "type": "object",
  "required": ["credential_id", "version", "key_id", "algorithm", "state", "secret_value_persisted"],
  "properties": {
    "credential_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string"},
    "algorithm": {"type": "string"},
    "fingerprint_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["staged", "active", "retiring", "retired", "revoked", "expired", "compromised"]},
    "secret_value_persisted": {"const": false}
  },
  "additionalProperties": true
}
