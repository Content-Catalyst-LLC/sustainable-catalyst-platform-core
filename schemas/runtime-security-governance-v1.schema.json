{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/runtime-security-governance-v1.schema.json",
  "title": "Sustainable Catalyst Runtime Security, Isolation & Governance",
  "type": "object",
  "required": [
    "bundle_id",
    "records"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "records": {
