    "contract": {
      "const": "sc.visual-runtime.grammar.v1"
    },
    "specification": {
      "type": "object"
    },
    "data_bindings": {
      "type": "array"
    },
    "marks": {
      "type": "array"
    },
    "encodings": {
      "type": "array"
    },
    "scales": {
      "type": "array"
    },
    "transforms": {
      "type": "array"
    },
    "guides": {
      "type": "array"
    },
    "snapshots": {
      "type": "array"
    },
    "boundaries": {
      "type": "object"
    }
  }
}
