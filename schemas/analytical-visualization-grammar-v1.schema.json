{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/analytical-visualization-grammar-v1.schema.json",
  "title": "Sustainable Catalyst Analytical Visualization Grammar v1",
  "type": "object",
  "required": [
    "contract",
    "specification",
    "marks",
    "encodings",
    "scales"
  ],
