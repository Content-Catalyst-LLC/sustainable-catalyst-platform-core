{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Map Channel",
  "type": "object",
  "required": [
    "visual_entity_id",
    "channel_key",
    "name",
    "flow_kind"
  ],
  "properties": {
    "visual_entity_id": {
      "type": "string"
    },
    "channel_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "flow_kind": {
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "order_index": {
      "type": "integer"
    },
    "metadata": {
      "type": "object"
    }
  }
}
