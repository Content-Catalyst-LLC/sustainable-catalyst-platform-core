    },
    "statistic_kind": {
      "type": "string"
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "lower_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "upper_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "probability": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_execution": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
