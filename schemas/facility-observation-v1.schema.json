{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/facility-observation-v1.schema.json",
  "title": "Sustainable Catalyst Facility Observation v1",
  "type": "object",
  "required": [
    "observation_kind",
    "status_value",
    "observed_at",
    "publisher"
  ],
  "properties": {
    "observation_kind": {
      "enum": [
        "operational-status",
        "damage-status",
        "access-status",
        "service-status",
        "capacity-status",
        "supply-status",
        "other"
      ]
    },
    "status_value": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "services": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    }
  }
}
