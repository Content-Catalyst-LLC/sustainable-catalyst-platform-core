{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/rust-runtime-v1.schema.json",
  "title": "Sustainable Catalyst Rust Runtime",
  "type": "object",
  "required": [
    "bundle_id",
    "registration",
    "environment_package",
    "security_policy",
    "reference_request",
