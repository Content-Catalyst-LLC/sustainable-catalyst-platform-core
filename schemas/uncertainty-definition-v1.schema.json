{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Uncertainty Definition",
  "required": [
    "uncertainty_key",
    "project_entity_id",
    "target_entity_id",
    "uncertainty_kind"
  ],
  "properties": {
    "uncertainty_key": {
      "type": "string"
    },
    "project_entity_id": {
      "type": "string"
    },
    "model_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_entity_id": {
      "type": "string"
    },
    "uncertainty_kind": {
      "enum": [
        "interval",
        "distribution",
        "empirical",
        "categorical",
        "qualitative"
      ]
    },
    "distribution_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "lower_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "upper_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence_level": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "parameters": {
      "type": "object"
    },
    "empirical_values": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    }
  }
}
