{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causal Graph",
  "type": "object",
  "required": [
    "graph_key",
    "name",
    "project_entity_id"
  ],
  "properties": {
    "graph_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "project_entity_id": {
      "type": "string"
    },
    "model_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "graph_state": {
      "type": "string"
    },
    "assumptions": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
