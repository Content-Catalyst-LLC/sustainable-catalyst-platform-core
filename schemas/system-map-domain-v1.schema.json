  "required": [
    "domain_key",
    "name"
  ],
  "properties": {
    "domain_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_domain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "order_index": {
