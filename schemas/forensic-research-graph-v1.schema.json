{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forensic Research Graph",
  "type": "object",
  "required": [
    "graph_key",
    "label"
  ],
  "properties": {
    "graph_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "type": "string"
    }
  }
}
