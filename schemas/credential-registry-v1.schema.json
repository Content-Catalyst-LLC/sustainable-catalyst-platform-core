{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/credential-registry-v1.schema.json",
  "title": "Credential Registry Metadata",
  "type": "object",
  "required": ["credential_key", "name", "credential_type", "purpose", "secret_reference"],
  "properties": {
    "credential_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "credential_type": {"type": "string"},
    "purpose": {"type": "string"},
    "owner_scope": {"type": "string"},
    "provider": {"type": "string"},
    "secret_reference": {"type": "string", "pattern": "^(env:|vault:|kms:|secret-manager:|external:).+"},
    "allowed_consumers": {"type": "array", "items": {"type": "string"}},
    "allowed_operations": {"type": "array", "items": {"type": "string"}},
    "rotation_interval_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "overlap_minutes": {"type": "integer", "minimum": 0, "maximum": 10080}
  },
  "additionalProperties": true
}
