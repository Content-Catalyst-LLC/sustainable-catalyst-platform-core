      "minItems": 1,
      "title": "Assessments",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/FederatedConflictRecord"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "contract": {
      "const": "sc.core.federated-evidence-graph-exchange.v1",
      "default": "sc.core.federated-evidence-graph-exchange.v1",
