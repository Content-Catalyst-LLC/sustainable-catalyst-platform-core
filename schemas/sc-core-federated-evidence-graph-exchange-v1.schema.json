    "evidence_graph_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Evidence Graph Mutation Performed",
      "type": "boolean"
    },
    "identity_graph_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Identity Graph Mutation Performed",
      "type": "boolean"
    },
    "integrity_attestations": {
      "items": {
        "$ref": "#/$defs/ExchangeIntegrityAttestation"
      },
      "minItems": 1,
