          "maxLength": 500,
          "minLength": 2,
          "title": "Assessment Ref",
          "type": "string"
        },
        "conflict_refs": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Refs",
          "type": "array"
        },
        "exchange_manifest_ref": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Exchange Manifest Ref",
          "type": "string"
        },
        "federation_exchange_snapshot_id": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Federation Exchange Snapshot Id",
          "type": "string"
        },
        "immutable": {
          "const": true,
          "default": true,
          "title": "Immutable",
          "type": "boolean"
        },
        "later_exchange_may_supersede_snapshot": {
          "const": true,
          "default": true,
          "title": "Later Exchange May Supersede Snapshot",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "node_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Node Refs",
          "type": "array"
        },
        "object_descriptor_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Object Descriptor Refs",
          "type": "array"
        },
        "package_reference_refs": {
          "items": {
            "type": "string"
          },
          "title": "Package Reference Refs",
