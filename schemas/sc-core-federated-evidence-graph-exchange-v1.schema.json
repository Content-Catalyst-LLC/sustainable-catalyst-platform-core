    "NodeTrustState": {
      "enum": [
        "registered",
        "authenticated",
        "suspended",
        "revoked"
      ],
      "title": "NodeTrustState",
      "type": "string"
    }
  },
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/InboundExchangeAssessment"
