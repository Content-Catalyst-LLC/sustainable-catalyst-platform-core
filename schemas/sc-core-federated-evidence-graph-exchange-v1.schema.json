      },
      "required": [
        "federation_exchange_snapshot_id",
        "exchange_manifest_ref",
        "assessment_ref",
        "node_refs",
        "object_descriptor_refs",
        "as_of"
      ],
      "title": "FederationExchangeSnapshot",
      "type": "object"
    },
    "FederationNodeIdentity": {
      "properties": {
        "federation_node_id": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Federation Node Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "node_uri": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Node Uri",
          "type": "string"
