      "title": "Package References",
      "type": "array"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/EvidenceGraphExchangePolicy"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    },
    "relationship_graph_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Relationship Graph Mutation Performed",
      "type": "boolean"
    },
    "release": {
      "const": "3.89.0",
      "default": "3.89.0",
      "title": "Release",
      "type": "string"
    },
    "snapshots": {
      "items": {
        "$ref": "#/$defs/FederationExchangeSnapshot"
      },
      "minItems": 1,
      "title": "Snapshots",
      "type": "array"
    }
