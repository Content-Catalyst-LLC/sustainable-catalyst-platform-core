        },
        "remote_objects_remain_remote_references": {
          "const": true,
          "default": true,
          "title": "Remote Objects Remain Remote References",
          "type": "boolean"
        },
        "snapshot_is_not_truth_verdict": {
          "const": true,
          "default": true,
          "title": "Snapshot Is Not Truth Verdict",
          "type": "boolean"
