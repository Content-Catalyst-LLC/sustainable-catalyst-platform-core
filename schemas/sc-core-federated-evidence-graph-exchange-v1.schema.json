      },
      "required": [
        "federation_node_id",
        "node_uri",
        "operator_name",
        "public_key_fingerprint_sha256",
        "trust_state",
        "registered_at"
      ],
      "title": "FederationNodeIdentity",
      "type": "object"
    },
    "InboundExchangeAssessment": {
      "properties": {
        "acceptance_does_not_promote_remote_assertions": {
          "const": true,
          "default": true,
          "title": "Acceptance Does Not Promote Remote Assertions",
          "type": "boolean"
        },
        "assessed_at": {
          "maxLength": 80,
          "minLength": 10,
          "title": "Assessed At",
          "type": "string"
        },
        "assessed_object_descriptor_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assessed Object Descriptor Refs",
