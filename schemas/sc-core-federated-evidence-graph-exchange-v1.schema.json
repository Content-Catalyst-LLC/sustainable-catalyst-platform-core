        },
        "inbound_exchange_assessment_id": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Inbound Exchange Assessment Id",
          "type": "string"
        },
        "integrity_attestation_ref": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Integrity Attestation Ref",
          "type": "string"
        },
        "local_validation_required": {
          "const": true,
          "default": true,
          "title": "Local Validation Required",
