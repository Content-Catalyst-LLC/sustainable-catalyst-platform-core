{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/forensic-evidence-item-v1.schema.json",
  "title": "Open Forensics Evidence Item",
  "type": "object",
  "required": ["evidence_key", "evidence_kind", "label"],
  "properties": {
    "evidence_key": {"type": "string", "minLength": 1, "maxLength": 180},
    "evidence_kind": {"type": "string"},
    "label": {"type": "string", "minLength": 1, "maxLength": 300},
    "content_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "hash_algorithm": {"type": ["string", "null"]},
    "source_snapshot_id": {"type": ["string", "null"]},
    "evidence_record_id": {"type": ["string", "null"]},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
