    "view_key",
    "name"
  ],
  "properties": {
    "visual_entity_id": {
      "type": "string"
    },
    "view_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "channel_ids": {
      "type": "array"
    },
    "filters": {
      "type": "object"
    },
    "time_window": {
      "type": "object"
    },
    "layout_intent": {
      "type": "object"
    },
    "specification_id": {
      "type": [
