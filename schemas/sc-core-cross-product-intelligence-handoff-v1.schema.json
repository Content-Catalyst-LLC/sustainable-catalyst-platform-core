          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "policy_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Policy Id",
          "type": "string"
        },
        "preserve_contradictions": {
          "const": true,
          "default": true,
          "title": "Preserve Contradictions",
          "type": "boolean"
