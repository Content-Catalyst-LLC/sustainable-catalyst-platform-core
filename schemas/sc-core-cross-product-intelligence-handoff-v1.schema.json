    "CrossProductHandoffReceipt": {
      "properties": {
        "accepted_payload_refs": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Payload Refs",
          "type": "array"
        },
        "applied_constraints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Applied Constraints",
          "type": "array"
        },
        "destination_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Destination Ref",
          "type": "string"
        },
        "granted_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Granted Scopes",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "receipt_does_not_promote_payload_state": {
          "const": true,
          "default": true,
          "title": "Receipt Does Not Promote Payload State",
          "type": "boolean"
        },
        "receipt_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_is_not_content_validation": {
          "const": true,
          "default": true,
          "title": "Receipt Is Not Content Validation",
          "type": "boolean"
        },
        "receipt_is_not_truth_assessment": {
          "const": true,
          "default": true,
          "title": "Receipt Is Not Truth Assessment",
          "type": "boolean"
        },
        "received_at": {
          "maxLength": 80,
          "minLength": 10,
          "title": "Received At",
          "type": "string"
        },
        "rejected_payload_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Payload Refs",
          "type": "array"
        },
        "request_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Request Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HandoffStatus"
        }
      },
      "required": [
        "receipt_id",
        "request_ref",
        "destination_ref",
        "status",
        "applied_constraints",
        "received_at"
      ],
      "title": "CrossProductHandoffReceipt",
      "type": "object"
    },
    "CrossProductHandoffSnapshot": {
      "properties": {
        "as_of": {
          "maxLength": 80,
          "minLength": 10,
          "title": "As Of",
          "type": "string"
        },
        "immutable": {
          "const": true,
          "default": true,
          "title": "Immutable",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "policy_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Policy Ref",
          "type": "string"
        },
        "receipt_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Receipt Refs",
          "type": "array"
        },
        "request_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Request Refs",
          "type": "array"
        },
        "snapshot_id": {
          "maxLength": 500,
          "minLength": 3,
