    "ConsumerKind": {
      "enum": [
        "workspace",
        "knowledge-library",
        "research-librarian",
        "research-lab",
        "workbench",
        "site-intelligence",
        "decision-studio",
        "external"
      ],
      "title": "ConsumerKind",
      "type": "string"
    },
