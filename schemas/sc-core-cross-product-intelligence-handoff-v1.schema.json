          "type": "object"
        },
        "negotiation_trace_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Negotiation Trace Ref",
          "type": "string"
        },
        "provenance_preserved": {
          "const": true,
          "default": true,
          "title": "Provenance Preserved",
          "type": "boolean"
        },
        "receipt_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Receipt Ref",
          "type": "string"
        },
        "remote_reference_state_preserved": {
          "const": true,
          "default": true,
          "title": "Remote Reference State Preserved",
          "type": "boolean"
        },
        "request_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Request Ref",
          "type": "string"
        },
        "return_contract_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Return Contract Ref",
          "type": "string"
        },
        "session_trace_ref": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Session Trace Ref",
          "type": "string"
        },
        "source_contracts_preserved": {
          "const": true,
          "default": true,
          "title": "Source Contracts Preserved",
          "type": "boolean"
        },
        "started_at": {
          "maxLength": 80,
          "minLength": 10,
          "title": "Started At",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Trace Id",
          "type": "string"
