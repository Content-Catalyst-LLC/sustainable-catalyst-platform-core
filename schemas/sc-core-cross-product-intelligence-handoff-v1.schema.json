        },
        "supersedable": {
          "const": true,
          "default": true,
          "title": "Supersedable",
          "type": "boolean"
        },
        "trace_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trace Refs",
          "type": "array"
