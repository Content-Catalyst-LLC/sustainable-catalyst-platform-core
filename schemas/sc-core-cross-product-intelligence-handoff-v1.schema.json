        "preserve_provenance": {
          "const": true,
          "default": true,
          "title": "Preserve Provenance",
          "type": "boolean"
        },
        "preserve_remote_reference_state": {
          "const": true,
          "default": true,
          "title": "Preserve Remote Reference State",
          "type": "boolean"
        },
        "preserve_source_contract_identity": {
          "const": true,
          "default": true,
          "title": "Preserve Source Contract Identity",
          "type": "boolean"
        },
        "preserve_validation_state": {
          "const": true,
          "default": true,
          "title": "Preserve Validation State",
          "type": "boolean"
        },
        "require_attributed_handoff_trace": {
          "const": true,
          "default": true,
          "title": "Require Attributed Handoff Trace",
          "type": "boolean"
        },
        "require_destination_capability_negotiation": {
          "const": true,
          "default": true,
          "title": "Require Destination Capability Negotiation",
          "type": "boolean"
        },
        "require_explicit_requested_action": {
          "const": true,
          "default": true,
          "title": "Require Explicit Requested Action",
          "type": "boolean"
        },
        "require_explicit_return_contract": {
          "const": true,
          "default": true,
          "title": "Require Explicit Return Contract",
          "type": "boolean"
        },
        "returned_outputs_require_validation_before_promotion": {
          "const": true,
          "default": true,
          "title": "Returned Outputs Require Validation Before Promotion",
          "type": "boolean"
        }
