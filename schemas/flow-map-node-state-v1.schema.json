    "element_id": {
      "type": "string"
    },
    "state_key": {
      "type": "string"
    },
    "state_kind": {
      "type": "string"
    },
    "quantity_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
