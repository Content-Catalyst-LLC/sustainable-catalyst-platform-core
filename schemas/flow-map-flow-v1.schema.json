{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Map Flow",
  "type": "object",
  "required": [
    "visual_entity_id",
    "flow_key",
    "relation_id",
    "quantity_kind",
    "flow_status"
  ],
  "properties": {
    "visual_entity_id": {
      "type": "string"
    },
    "flow_key": {
      "type": "string"
    },
    "relation_id": {
      "type": "string"
    },
    "channel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantity_kind": {
      "type": "string"
    },
    "quantity_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "lower_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "upper_bound": {
      "type": [
        "number",
        "null"
      ]
    },
    "flow_status": {
      "type": "string"
    },
    "uncertainty": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
