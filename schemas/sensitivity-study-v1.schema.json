{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Sensitivity Study",
  "required": [
    "study_key",
    "project_entity_id",
    "model_entity_id",
    "model_version_entity_id",
    "method"
  ],
  "properties": {
    "study_key": {
      "type": "string"
    },
    "project_entity_id": {
      "type": "string"
    },
    "model_entity_id": {
      "type": "string"
    },
    "model_version_entity_id": {
      "type": "string"
    },
    "compute_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "study_state": {
      "enum": [
        "draft",
        "ready",
        "running",
        "completed",
        "archived"
      ]
    },
    "method": {
      "enum": [
        "one-at-a-time",
        "local-gradient",
        "morris",
        "sobol",
        "variance-based",
        "correlation",
        "scenario-sweep",
        "custom"
      ]
    },
    "output_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "sampling_contract": {
      "type": "object"
    },
    "execution_product": {
      "type": "string"
    }
  }
}
