    "outcome_variable_id"
  ],
  "properties": {
    "treatment_variable_id": {
      "type": "string"
    },
    "outcome_variable_id": {
      "type": "string"
    },
    "estimand": {
      "type": "string"
    },
    "identification_method": {
      "type": "string"
    },
