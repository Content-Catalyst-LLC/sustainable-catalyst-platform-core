{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Spatial Temporal Feature",
  "required": [
    "feature_key",
    "label",
    "geometry"
  ],
  "properties": {
    "feature_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "geometry": {
      "type": "object"
    },
    "srid": {
      "type": "integer"
    },
    "crs": {
      "type": "string"
    }
  }
}
