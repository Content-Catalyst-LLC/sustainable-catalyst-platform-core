{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/unified-research-project-v1.schema.json",
  "title": "Sustainable Catalyst Unified Research Project v1",
  "type": "object",
  "required": [
    "contract",
    "project",
    "questions",
    "objectives",
    "components",
    "relationships",
    "provenance_records",
    "handoffs",
    "boundaries"
