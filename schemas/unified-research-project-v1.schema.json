      "const": "sc.research.unified-project.v1"
    },
    "project": {
      "type": "object"
    },
    "questions": {
      "type": "array"
    },
    "objectives": {
      "type": "array"
    },
    "components": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "provenance_records": {
      "type": "array"
    },
    "handoffs": {
      "type": "array"
    },
