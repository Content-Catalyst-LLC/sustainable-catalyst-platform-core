{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/change-control-v1.schema.json",
  "title": "Sustainable Catalyst Change Control Record",
  "type": "object",
  "required": ["change_key", "risk", "state"],
  "properties": {
    "change_key": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "state": {"enum": ["planned", "approved", "in_progress", "completed", "failed", "cancelled"]}
  },
  "additionalProperties": true
}
