  "properties": {
    "comparison_key": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_scope": {
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "project_entity_id": {
      "type": "string"
    },
    "target_semantics": {
      "type": "object"
    },
    "visibility": {
      "enum": [
