{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/python-runtime-v1.schema.json",
  "title": "Sustainable Catalyst Python Runtime v1",
  "type": "object",
  "required": [
    "bundle_id",
    "registration",
    "environment_package",
    "security_policy",
    "reference_request",
    "result_contract"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "registration": {
      "type": "object"
    },
    "environment_package": {
      "type": "object"
    },
    "security_policy": {
      "type": "object"
    },
    "reference_request": {
      "type": "object"
    },
    "result_contract": {
      "type": "object"
    },
    "source_object_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
